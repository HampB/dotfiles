{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
# Linux / WSL / devcontainer tooling. Re-runs whenever this script changes.
set -eu

mkdir -p "$HOME/.local/share/fonts" "$HOME/.local/bin"

# fzf key bindings + completion (repo is cloned via .chezmoiexternal.toml)
if [ -x "$HOME/.zsh_addons/fzf/install" ]; then
  "$HOME/.zsh_addons/fzf/install" --all --no-bash --no-fish --no-update-rc
fi

if command -v apt-get >/dev/null 2>&1; then
  SUDO=""
  if [ "$(id -u)" -ne 0 ]; then
    if command -v sudo >/dev/null 2>&1; then SUDO="sudo"; else SUDO="skip"; fi
  fi
  if [ "$SUDO" = "skip" ]; then
    echo "Skipping apt install (not root and sudo is unavailable)."
  else
    $SUDO apt-get update -y
    $SUDO apt-get install -y zip unzip ripgrep
  fi
fi

if command -v wget >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
  tmp_zip="$(mktemp /tmp/hack-nerd-font.XXXXXX.zip)"
  wget -qO "$tmp_zip" "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Hack.zip"
  unzip -o "$tmp_zip" -d "$HOME/.local/share/fonts" >/dev/null
  rm -f "$tmp_zip"
fi

curl -sSfL "https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh" | sh
curl -sS "https://webi.sh/lf" | sh
curl -sS "https://starship.rs/install.sh" | sh -s -- -y -b "$HOME/.local/bin"

curl -fsSL "https://raw.githubusercontent.com/fishtown-analytics/dbt-completion.bash/master/dbt-completion.bash" \
  -o "$HOME/.dbt-completion.bash"
{{- end }}
